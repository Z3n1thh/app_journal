{
  "name": "Bujo Mood Tracker",
  "short_name": "Bujo Mood",
  "description": "Your personal bullet journal for moods and wellness",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f7f4ef",
  "theme_color": "#8b6914",
  "shortcuts": [
    { "name": "Log today", "short_name": "Log", "url": "/?action=log", "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }] },
    { "name": "Quick log", "short_name": "Quick", "url": "/?action=quicklog", "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }] },
    { "name": "Calendar", "short_name": "Cal", "url": "/?page=calendar", "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }] },
    { "name": "Week", "short_name": "Week", "url": "/?page=week", "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }] },
    { "name": "Insights", "short_name": "Stats", "url": "/?page=insights", "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
